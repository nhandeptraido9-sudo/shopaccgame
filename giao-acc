<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nhận Acc Blox Fruits</title>

<style>
body{
  margin:0;
  background:#eef3f8;
  font-family:Arial;
  color:#172033;
}

.box{
  max-width:600px;
  margin:45px auto;
  background:white;
  border-radius:18px;
  padding:25px;
  box-shadow:0 5px 25px #0002;
}

.row{
  padding:14px;
  margin:10px 0;
  background:#f4f7fb;
  border-radius:10px;
}

input{
  width:100%;
  padding:13px;
  margin:8px 0;
  box-sizing:border-box;
  border:1px solid #ddd;
  border-radius:10px;
}

button{
  width:100%;
  padding:13px;
  border:0;
  border-radius:10px;
  background:#16a34a;
  color:white;
  font-weight:bold;
  cursor:pointer;
}

.account{
  display:none;
  margin-top:20px;
  padding:18px;
  background:#ecfdf3;
  border-radius:12px;
}

.copy{
  background:#2563eb;
  margin-top:10px;
}
</style>
</head>

<body>

<div class="box">

<h1>🎮 Nhận Acc Blox Fruits</h1>

<div class="row">
Túi đã chọn: <b id="bag">-</b>
</div>

<div class="row">
Số tiền: <b id="price">-</b>
</div>

<h3>Thông tin Acc</h3>

<input id="username" placeholder="Username Roblox">

<input id="password" type="password" placeholder="Password Roblox">

<button onclick="deliverAccount()">
🎁 GIAO ACC
</button>

<div id="account" class="account">

<h3>✅ Thông tin tài khoản</h3>

<p>👤 Username: <b id="showUsername"></b></p>

<p>🔑 Password: <b id="showPassword"></b></p>

<button class="copy" onclick="copyAccount()">
📋 Sao chép thông tin
</button>

</div>

</div>

<script>

const q = new URLSearchParams(location.search);

const bag = q.get("bag") || "1";
const price = Number(q.get("price") || 0);

document.getElementById("bag").textContent =
  "Túi số " + bag;

document.getElementById("price").textContent =
  price.toLocaleString("vi-VN") + " ₫";


function deliverAccount(){

  const username =
    document.getElementById("username").value.trim();

  const password =
    document.getElementById("password").value;

  if(!username || !password){
    alert("Vui lòng nhập Username và Password!");
    return;
  }

  document.getElementById("showUsername").textContent =
    username;

  document.getElementById("showPassword").textContent =
    password;

  document.getElementById("account").style.display =
    "block";
}


function copyAccount(){

  const username =
    document.getElementById("showUsername").textContent;

  const password =
    document.getElementById("showPassword").textContent;

  navigator.clipboard.writeText(
    "Username: " + username +
    "\nPassword: " + password
  );

  alert("Đã sao chép thông tin!");
}

</script>

</body>
</html>
